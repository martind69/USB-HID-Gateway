CONFIG_USB_GATEWAY_CAPTURE_ENABLE=y
CONFIG_USB_GATEWAY_CAPTURE_DIAG_PERIOD_S=5
CONFIG_USB_GATEWAY_CAPTURE_LEVEL_SD=y
CONFIG_USB_GATEWAY_CAPTURE_SD_DURATION_S=600
CONFIG_USB_GATEWAY_CAPTURE_SD_MAX_TOTAL_MIB=256
CONFIG_USB_GATEWAY_CAPTURE_SD_FILE_MIB=8
CONFIG_USB_GATEWAY_CAPTURE_SD_FLUSH_MS=1000
CONFIG_USB_GATEWAY_CAPTURE_SD_QUEUE_DEPTH=512
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
