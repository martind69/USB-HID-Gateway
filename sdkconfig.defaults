CONFIG_IDF_TARGET="esp32p4"
CONFIG_TINYUSB_HID_COUNT=1

# The standalone mouse test disables USB Host. Keep it disabled for the
# default USB Host enumeration test configuration.
CONFIG_USB_GATEWAY_USB_DEVICE_MOUSE_TEST=n

# Enable external USB hub support for the Type-A host topology.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y

# Keep the experimental enumeration-stage delay disabled by default.
CONFIG_USB_GATEWAY_ENUMERATION_STAGE_DELAY_MS=0
