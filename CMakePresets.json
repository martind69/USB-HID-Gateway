{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Primary ESP32-P4",
            "generator": "Ninja",
            "binaryDir": "build/default",
            "cacheVariables": {
                "SDKCONFIG": "${sourceDir}/build/default/sdkconfig",
                "IDF_TARGET": "esp32p4"
            }
        },
        {
            "name": "verbose",
            "displayName": "Primary ESP32-P4",
            "generator": "Ninja",
            "binaryDir": "build/verbose",
            "cacheVariables": {
                "IDF_TARGET": "esp32p4",
                "SDKCONFIG": "build/verbose/sdkconfig",
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.verbose"
            }
		},
        {
            "name": "production",
            "displayName": "Primary ESP32-P4",
            "generator": "Ninja",
            "binaryDir": "build/production",
            "cacheVariables": {
                "SDKCONFIG": "${sourceDir}/build/production/sdkconfig",
                "IDF_TARGET": "esp32p4"
            }
        }
    ]
}
