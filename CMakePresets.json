{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "build/default",
            "cacheVariables": {
                "SDKCONFIG": "${sourceDir}/build/default/sdkconfig",
                "IDF_TARGET": "esp32p4"
            }
        },
        {
            "name": "production",
            "generator": "Ninja",
            "binaryDir": "build/production",
            "cacheVariables": {
                "SDKCONFIG": "${sourceDir}/build/production/sdkconfig",
                "IDF_TARGET": "esp32p4"
            }
        }
    ]
}
