menu "Secondary S3 link and USB keyboard"

config SECONDARY_S3_SPI_SCLK_GPIO
    int "SPI SCLK GPIO"
    default 12

config SECONDARY_S3_SPI_MOSI_GPIO
    int "SPI MOSI GPIO"
    default 11

config SECONDARY_S3_SPI_MISO_GPIO
    int "SPI MISO GPIO"
    default 13

config SECONDARY_S3_SPI_CS_GPIO
    int "SPI CS GPIO"
    default 10

config SECONDARY_S3_LINK_IRQ_GPIO
    int "Optional link IRQ GPIO"
    default 9

config SECONDARY_S3_KEYBOARD_QUEUE_DEPTH
    int "Keyboard report queue depth"
    range 8 128
    default 32

endmenu
