# =============================================================================
# Target & Flash
# =============================================================================
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# =============================================================================
# USB Device (TinyUSB HID Only)
# =============================================================================
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_CDC_COUNT=0
CONFIG_TINYUSB_MSC_COUNT=0
CONFIG_TINYUSB_MIDI_COUNT=0
CONFIG_TINYUSB_AUDIO_COUNT=0
CONFIG_TINYUSB_VENDOR_COUNT=0
CONFIG_TINYUSB_NET_MODE_NONE=y

# =============================================================================
# Unused Radio & Network Functions
# =============================================================================
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n

CONFIG_ETH_USE_OPENETH=n
CONFIG_ETH_USE_SPI_ETHERNET=n
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_IPV6=n

# =============================================================================
# Application: SPI Link & HID Queue
# =============================================================================
CONFIG_SECONDARY_S3_SPI_SCLK_GPIO=12
CONFIG_SECONDARY_S3_SPI_MOSI_GPIO=11
CONFIG_SECONDARY_S3_SPI_MISO_GPIO=13
CONFIG_SECONDARY_S3_SPI_CS_GPIO=10
CONFIG_SECONDARY_S3_LINK_IRQ_GPIO=9

CONFIG_SECONDARY_S3_KEYBOARD_QUEUE_DEPTH=32
