CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BT_ENABLED=n
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_SECONDARY_S3_SPI_SCLK_GPIO=12
CONFIG_SECONDARY_S3_SPI_MOSI_GPIO=11
CONFIG_SECONDARY_S3_SPI_MISO_GPIO=13
CONFIG_SECONDARY_S3_SPI_CS_GPIO=10
CONFIG_SECONDARY_S3_LINK_IRQ_GPIO=9
CONFIG_SECONDARY_S3_KEYBOARD_QUEUE_DEPTH=32

# No radio functions
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n

# No Ethernet or PPP
# CONFIG_ETH_USE_ESP32_EMAC is not set
# CONFIG_ETH_USE_OPENETH is not set
# CONFIG_LWIP_PPP_SUPPORT is not set

# TinyUSB: HID only
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_AUDIO_COUNT=0
CONFIG_TINYUSB_CDC_COUNT=0
CONFIG_TINYUSB_MSC_COUNT=0
CONFIG_TINYUSB_MIDI_COUNT=0
