menu "Capture and diagnostics"
config USB_GATEWAY_CAPTURE_ENABLE
    bool "Enable capture (periodic diagnostics on the monitor)"
    default n
    help
        Master switch. Enables the periodic diagnostic report (system, USB,
        proxy, P4/S3 link, I2C) and the analog bus scan at boot. Event
        messages such as device attach/detach and errors are always logged.
config USB_GATEWAY_CAPTURE_DIAG_PERIOD_S
    int "Diagnostic report period in seconds"
    depends on USB_GATEWAY_CAPTURE_ENABLE
    range 1 3600
    default 5
choice USB_GATEWAY_CAPTURE_LEVEL
    prompt "Capture level"
    depends on USB_GATEWAY_CAPTURE_ENABLE
    default USB_GATEWAY_CAPTURE_LEVEL_MONITOR
    help
        MONITOR: periodic diagnostics on the console only.
        SD: additionally a binary event log under /sdcard/logs, started at boot.
config USB_GATEWAY_CAPTURE_LEVEL_MONITOR
    bool "MONITOR - console diagnostics"
config USB_GATEWAY_CAPTURE_LEVEL_SD
    bool "SD - console diagnostics and SD event log"
endchoice
config USB_GATEWAY_CAPTURE_SD_DURATION_S
    int "SD event log duration in seconds (0 = until size budget)"
    depends on USB_GATEWAY_CAPTURE_LEVEL_SD
    range 0 86400
    default 600
config USB_GATEWAY_CAPTURE_SD_MAX_TOTAL_MIB
    int "SD event log size budget per session in MiB"
    depends on USB_GATEWAY_CAPTURE_LEVEL_SD
    range 1 4096
    default 256
config USB_GATEWAY_CAPTURE_SD_FILE_MIB
    int "SD event log maximum file size in MiB"
    depends on USB_GATEWAY_CAPTURE_LEVEL_SD
    range 1 1024
    default 8
config USB_GATEWAY_CAPTURE_SD_FLUSH_MS
    int "SD event log flush interval in ms"
    depends on USB_GATEWAY_CAPTURE_LEVEL_SD
    range 100 60000
    default 1000
config USB_GATEWAY_CAPTURE_SD_QUEUE_DEPTH
    int "SD event log record queue depth"
    depends on USB_GATEWAY_CAPTURE_LEVEL_SD
    range 16 4096
    default 512
endmenu
