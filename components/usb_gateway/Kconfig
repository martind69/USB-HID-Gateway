menu "P4 to S3 SPI2 bus"
config USB_GATEWAY_S3_SPI_SCLK_GPIO
    int "S3 SPI SCLK GPIO"
    default 6
config USB_GATEWAY_S3_SPI_MOSI_GPIO
    int "S3 SPI MOSI GPIO"
    default 7
config USB_GATEWAY_S3_SPI_MISO_GPIO
    int "S3 SPI MISO GPIO"
    default 8
config USB_GATEWAY_S3_SPI_CS_GPIO
    int "S3 SPI chip-select GPIO"
    default 22
config USB_GATEWAY_S3_SPI_HZ
    int "S3 SPI frequency"
    range 1000000 20000000
    default 10000000
config USB_GATEWAY_S3_REARM_GUARD_US
    int "S3 SPI slave re-arm guard time in microseconds"
    range 50 5000
    default 500
    help
        Delay after a completed or timed-out command before starting the next
        SPI transaction. This gives the ESP32-S3 slave task time to process the
        received frame and queue the next 72-byte transaction.
endmenu

