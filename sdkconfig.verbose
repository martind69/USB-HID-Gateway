CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_ENABLE=y
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_BOOT_ENABLE=n
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_DURATION_S=600
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_MAX_TOTAL_MIB=256
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_FILE_MIB=8
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_FLUSH_MS=1000
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_QUEUE_DEPTH=512
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_INCLUDE_USB=y
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_INCLUDE_SPI=y
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_INCLUDE_ANALOG=y
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_INCLUDE_PROFILE=y
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_INCLUDE_TIMING=y
CONFIG_USB_GATEWAY_VERBOSE_CAPTURE_PAYLOADS=n
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y